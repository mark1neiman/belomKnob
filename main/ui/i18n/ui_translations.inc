static const char *ui_translation_lookup(const char *key)
{
    if (!key) {
        return NULL;
    }
    for (size_t i = 0; i < (sizeof(ui_translation_entries) / sizeof(ui_translation_entries[0])); ++i) {
        if (strcmp(ui_translation_entries[i].key, key) != 0) {
            continue;
        }
        const char *picked = ui_translation_entries[i].v[current_lang];
        if (!picked || !picked[0]) {
            picked = ui_translation_entries[i].v[LANG_EN];
        }
        return picked;
    }
    return NULL;
}
